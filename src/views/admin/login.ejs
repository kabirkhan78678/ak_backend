<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OneTradefx — Admin Login</title>

    <!-- favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --neon: #2bd96f;
            --card-bg: #fff;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #020608;
            font-family: system-ui, Segoe UI, Roboto, Arial;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background: url("/images/BTFX.png") center/cover no-repeat;
            filter: blur(14px);
            opacity: .18;
            z-index: -1;
        }

        .login-card {
            max-width: 420px;
            width: 100%;
            padding: 28px;
            background: var(--card-bg);
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .5);
        }

        h2 {
            color: var(--neon);
            text-align: center;
            font-weight: 700
        }
    </style>
</head>

<body>

    <div class="login-card">

        <h2>Admin Login</h2>
        <p class="text-center text-muted mb-3">Sign in to manage OneTradeFx</p>

        <% if (error) { %>
            <div class="alert alert-danger py-2">
                <%= error %>
            </div>
            <% } %>

                <form method="POST" action="admin/login">

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control form-control-lg" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="password" class="form-control form-control-lg" required>
                    </div>

                    <button class="btn btn-success btn-lg w-100">Sign In</button>

                </form>

                <div class="text-center mt-3 text-muted small">
                    Only authorized admins can access this panel
                </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>