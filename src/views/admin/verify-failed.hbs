<!DOCTYPE html>
<html>
<head>
  <title>{{title}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: Arial;
      background: #f6f7f9;
      padding: 40px 12px;
    }
    .card {
      max-width: 520px;
      margin: auto;
      padding: 24px;
      background: #fff;
      border-radius: 12px;
      border: 1px solid #eee;
      text-align: center;
    }
    h2 { color: #c62828; }
    p { color: #444; }
  </style>
</head>
<body>

  <div class="card">
    <h2>✖ Verification Failed</h2>
    <p>{{message}}</p>
  </div>

</body>
</html>
