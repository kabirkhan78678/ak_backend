<!DOCTYPE html>
<html>
<head>
  <title>{{title}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f6f7f9;
      padding: 40px 12px;
    }

    .card {
      max-width: 520px;
      margin: auto;
      padding: 24px;
      background: #fff;
      border-radius: 12px;
      border: 1px solid #eee;
      text-align: center;
    }

    .logo img {
      height: 50px;
      margin-bottom: 20px;
    }

    h2 {
      color: #333;
      margin-bottom: 12px;
    }

    p {
      color: #444;
      font-size: 15px;
      margin-bottom: 22px;
    }

    .success {
      color: #2e7d32;
    }

    .btn {
      display: inline-block;
      padding: 12px 22px;
      background: #4CAF50;
      color: #fff;
      text-decoration: none;
      border-radius: 6px;
      font-size: 14px;
      margin-bottom: 14px;
    }

    .btn-secondary {
      display: block;
      margin-top: 10px;
      color: #4CAF50;
      text-decoration: none;
      font-size: 14px;
    }

    hr {
      margin: 26px 0;
      border: 0;
      border-top: 1px solid #eee;
    }

    .footer {
      color: #888;
      font-size: 12px;
    }
  </style>
</head>
<body>

  <div class="card">

    {{#if logo}}
      <div class="logo">
        <img src="{{logo}}" alt="Logo">
      </div>
    {{/if}}

    <h2 class="success">✔ Email Verified</h2>

    <p>Your email has been successfully verified.<br>
       You can now log in to your account.</p>

    <a href="myapp://login" class="btn">Open App</a>

    <a href="{{webUrl}}" class="btn-secondary">Login on Web</a>

    <hr>

    <div class="footer">
      © {{year}} {{appName}}
    </div>

  </div>

</body>
</html>
